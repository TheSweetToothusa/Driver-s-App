                };
                
                const upsellNames = {
                    'rh-plaque': 'Large "Happy New Year" Chocolate Plaque',
                    'rh-apple': 'Chocolate & Caramel Apple',
                    'red-apple': 'Classic Red Candy Apple',
                    'apple-sticks': 'Chocolate-Dipped Apple Sticks (6-pack)',
                    'lollipop': 'Chocolate Apple Lollipop',
                    'mini-shofars': 'Mini Chocolate Shofars (12-pack)',
                    'large-shofar': 'Large Chocolate Shofar',
                    'kiddush': 'Chocolate Kiddush Cup',
                    'pretzels6': 'Chocolate-Dipped Pretzels (6-pack)',
                    'oreos6': 'Chocolate-Dipped Oreos (6-pack)',
                    'truffles': 'Assorted Truffles (9-pack)',
                    'cookies': 'Gourmet Cookies (6-pack)',
                    'brownies': 'Chocolate Chip Brownies (6-pack)'
                };
                
                // Add upsells as separate line items
                for (const [upsellId, upsellData] of Object.entries(upsellQuantities)) {
                    const qty = upsellData.qty || 0;
                    if (qty > 0) {
                        let variantId = upsellVariants[upsellId];
                        let upsellProps = { 'Add-on for': basketData.name + ' basket' };
                        
                        // Handle cookies with flavor selection
