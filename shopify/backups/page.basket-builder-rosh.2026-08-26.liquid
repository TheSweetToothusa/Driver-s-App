        /* Container Toggle (Basket vs Bassinet) - More prominent styling */
        .container-toggle {
            display: none;
            max-width: 520px;
            margin: 0 auto 30px;
            background: linear-gradient(135deg, #fff5f7 0%, #fdf2f4 100%);
            border: 2px solid #fecdd3;
