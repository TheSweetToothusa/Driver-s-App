                // Upsell variant IDs - mapped to actual Shopify products
                const upsellVariants = {
                    'rh-plaque':    { dairy: 47185493229823, vegan: 47185493262591 },
                    'rh-apple':     { dairy: 47234680488191, vegan: 48932045259007 },
                    'red-apple':    46195034685695,
                    'apple-sticks': { dairy: 47174754631935, vegan: 47174754664703 },
                    'lollipop':     { dairy: 49042667667711, vegan: 49042667700479 },
                    'mini-shofars': { dairy: 49042667766015, vegan: 49042667798783 },
                    'large-shofar': { dairy: 49042668060927, vegan: 49042668093695 },
                    'kiddush':      { dairy: 49032214151423, vegan: 49032214184191 },
                    'pretzels6':    { dairy: 49042668159231, vegan: 49042668191999 },
                    'oreos6':       { dairy: 49042668323071, vegan: 49042668355839 },
                    'truffles':     { dairy: 48000994541823, vegan: 48740479926527 },
                    'cookies': {
                        'choc-chip': 48000994377983,
                        'white-choc': 48000994410751,
                        'oatmeal': 48000994443519,
                        'mixed': 48236883837183
                    },
