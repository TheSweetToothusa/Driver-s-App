                        // Any add-on with dairy/vegan variants follows the basket's Dairy/Parve selection
                        if (variantId && typeof variantId === 'object' && variantId.dairy) {
                            const dk = selectedDiet === 'vegan' ? 'vegan' : 'dairy';
                            variantId = variantId[dk];
                            upsellProps['Assortment'] = selectedDiet === 'vegan' ? 'Vegan/Parve' : 'Dairy';
