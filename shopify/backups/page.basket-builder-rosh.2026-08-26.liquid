                    quantity: 1,
                    properties: properties
                });
                
                // Add gluten-free upgrade as separate line item
                if (glutenFreeUpgrade) {
                    cartItems.push({
                        id: 48212759380223,
                        quantity: 1,
                        properties: { 'Upgrade for': basketData.name + ' basket' }
                    });
                }
            }
            
            // If no basket selected, show error
            if (cartItems.length === 0) {
                alert('Please select a basket size first.');
                return;
            }
            
            // Log what we're sending
            console.log('=== BASKET BUILDER CHECKOUT ===');
            console.log('Occasion:', selectedOccasion);
            console.log('Diet:', selectedDiet);
            console.log('Basket:', basketData);
            console.log('Container:', containerType);
            console.log('Upsells:', upsellQuantities);
            console.log('Cart Items:', cartItems);
            
            // Build the cart note + attributes once, so both the normal path and the
            // fallback path below can use them.
            let cartNote = 'Basket Builder — ' + selectedOccasion;
            let cartAttributes = { 'Basket Builder': 'Yes', 'Occasion': selectedOccasion };
            if (selectedOccasion === 'College Acceptance' && schoolName) {
                cartNote += ' — School: ' + schoolName;
                cartAttributes['School'] = schoolName;
            }
            // Surface the free plaque at order level so it appears in the customer's
            // order confirmation email under "Additional details".
            if (freePlaqueByOccasion[selectedOccasion]) {
                cartAttributes['Chocolate Plaque'] = freePlaqueByOccasion[selectedOccasion] + ' — included free';
            }
            if (selectedOccasion === 'Rosh Hashanah') {
                cartAttributes['Holiday Additions'] = 'Rosh Hashanah chocolates included — mini honey jar, "Happy New Year" plaque, chocolate shofar, chocolate apple & more';
            }

            // FALLBACK (added 2026-08-07). Shopify sometimes answers /cart/*.js with an HTML
            // "Verifying your connection..." bot-check or a 429 instead of JSON. A fetch() can
            // never clear that challenge, so the customer gets stuck forever. A real form POST
            // is a top-level navigation, which does clear it — and still adds the basket.
            function submitCartViaForm() {
                var f = document.createElement('form');
                f.method = 'post';
                f.action = '/cart/add';
                f.acceptCharset = 'UTF-8';
                f.style.display = 'none';
                function put(name, value) {
                    var i = document.createElement('input');
                    i.type = 'hidden';
                    i.name = name;
                    i.value = String(value);
                    f.appendChild(i);
                }
                cartItems.forEach(function (it, ix) {
                    put('items[' + ix + '][id]', it.id);
                    put('items[' + ix + '][quantity]', it.quantity);
                    var props = it.properties || {};
                    Object.keys(props).forEach(function (k) {
                        put('items[' + ix + '][properties][' + k + ']', props[k]);
                    });
                });
                put('note', cartNote);
                Object.keys(cartAttributes).forEach(function (k) {
                    put('attributes[' + k + ']', cartAttributes[k]);
                });
                put('return_to', '/cart');
                document.body.appendChild(f);
                f.submit();
            }

            // Replace the cart, safely (reworked 2026-08-07).
            // This used to call /cart/clear.js FIRST, so if the add then failed the customer
            // was left with an empty cart and no basket. Now we note what is already in the
            // cart, add the new basket, and only remove the old lines once the add succeeded.
            var stOldKeys = [];
            fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
                .then(function (r) {
                    var ct = r.headers.get('content-type') || '';
                    return (r.ok && ct.indexOf('json') !== -1) ? r.json() : null;
                })
                .catch(function () { return null; })
                .then(function (existing) {
                    if (existing && existing.items) {
                        stOldKeys = existing.items.map(function (i) { return i.key; });
                    }
                    return fetch('/cart/add.js', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ items: cartItems })
                    });
                })
                .then(function (response) {
                    // If Shopify handed back HTML (bot check) or throttled us, bail to the form.
                    var ct = response.headers.get('content-type') || '';
                    if (ct.indexOf('json') === -1 || response.status === 429 || response.status === 430) {
                        var err = new Error('non-json cart response: ' + response.status);
                        err.useFormFallback = true;
                        throw err;
                    }
                    return response.json();
                })
                .then(function (data) {
                    console.log('Cart response:', data);

                    if (data && data.items && data.items.length > 0) {
                        // Success. Set the note, then go — but never let the note call
                        // block the customer from reaching their cart.
                        // Add succeeded. Now drop whatever was in the cart beforehand,
                        // and set the note — one request, and only on the happy path.
                        var stUpdates = {};
                        stOldKeys.forEach(function (k) { stUpdates[k] = 0; });
                        return fetch('/cart/update.js', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ updates: stUpdates, note: cartNote, attributes: cartAttributes })
                        })
                            .catch(function () { /* cosmetic only — never block the customer */ })
                            .then(function () { window.location.href = '/cart'; });
                    }

                    if (data && data.description) {
                        // A genuine Shopify rejection (sold out, bad variant). Say so plainly.
                        console.error('Shopify error:', data, cartItems);
                        alert('Sorry — we could not add that to your cart: ' + data.description + '\n\nPlease pick a different option, or call us and we will build it for you.');
                        return;
                    }

                    window.location.href = '/cart';
                })
                .catch(function (error) {
                    console.error('Checkout error, using form fallback:', error);
                    submitCartViaForm();
                });
        }
        
        // URL Parameter Handling - allows direct links like ?product=bassinet&occasion=baby
        document.addEventListener('DOMContentLoaded', function() {
            // Clear school name error on typing
            const schoolInput = document.getElementById('school-name-input');
            if (schoolInput) {
                schoolInput.addEventListener('input', function() {
                    if (this.value.trim()) {
                        document.getElementById('school-name-error').style.display = 'none';
                        this.style.border = '';
                    }
                });
            }
            
            const urlParams = new URLSearchParams(window.location.search);
            const product = urlParams.get('product');
            const occasion = urlParams.get('occasion');
            const gfParam = urlParams.get('gf');

            // Disabled 2026-08-07: gluten-free upgrade product is unpublished, so enabling it
            // blocked add-to-cart. Re-enable only when the product is live on the Online Store.
            void gfParam;
            
            // If occasion is specified, auto-select it
            if (occasion) {
                const occasionMap = {
                    // Core occasions (must match h3 text exactly)
                    'baby': 'Baby',
                    'new-baby': 'Baby',
                    'birthday': 'Birthday',
                    'thank-you': 'Thank You',
                    'thankyou': 'Thank You',
                    'sympathy': 'Sympathy/Shiva',
                    'shiva': 'Sympathy/Shiva',
                    'congratulations': 'Congratulations',
                    'congrats': 'Congratulations',
                    'corporate': 'Corporate',
                    'teacher': 'Teacher Appreciation',
                    'teacher-appreciation': 'Teacher Appreciation',
                    'just-because': 'Just Because',
                    'justbecause': 'Just Because',
                    'get-well': 'Get Well',
                    'getwell': 'Get Well',
                    'anniversary': 'Anniversary',
                    'housewarming': 'Housewarming',
                    'graduation': 'Graduation',
                    'college': 'College Acceptance',
                    'college-acceptance': 'College Acceptance',
                    'bed-party': 'College Acceptance',
                    'college-bed-party': 'College Acceptance',
                    // Holidays (seasonal - active 3-4 weeks before)
                    'valentines': "Valentine's Day",
                    'valentines-day': "Valentine's Day",
                    'thanksgiving': 'Thanksgiving',
                    'rosh-hashanah': 'Rosh Hashanah',
                    'roshhashanah': 'Rosh Hashanah',
                    'sukkot': 'Sukkot',
                                        'passover': 'Passover',
                    'pesach': 'Passover',
                    'christmas': 'Christmas',
                    'hanukkah': 'Hanukkah',
                    'chanukah': 'Hanukkah',
                    'fathers-day': "Father's Day",
                    'fathersday': "Father's Day"
                };
                const occasionName = occasionMap[occasion.toLowerCase()] || occasion;
                
                // Find and click the matching occasion card
                document.querySelectorAll('.occasion-card').forEach(card => {
                    if (card.querySelector('h3') && card.querySelector('h3').textContent.trim() === occasionName) {
                        card.click();
                        // Auto-advance to Step 2 (size selection) after a brief delay
                        setTimeout(function() {
                            goToStep('step-size');
                        }, 150);
                    }
                });
            }
            
            // If product=bassinet, switch to bassinet view (after occasion is set)
            if (product && product.toLowerCase() === 'bassinet') {
                setTimeout(function() {
                    // Make sure we're on the size step and toggle is visible
                    if (document.getElementById('container-toggle').classList.contains('visible')) {
                        toggleContainer('bassinet');
                    }
                }, 100);
            }
        });
    
    </script>

