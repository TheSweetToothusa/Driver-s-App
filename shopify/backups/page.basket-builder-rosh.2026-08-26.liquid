<style>
  /* -- "See it wrapped" toggle.
        A full-width BAR across the bottom of the card, in normal flow.
        44-46px tall so it is easy to hit; a miss used to select the basket
        and jump the page. Square corners, so it is never confused with the
        "Serves X people" pill. One pill per card, always. -- */
  .basket-card{position:relative;}
  .basket-card .rh-flip{position:static;flex:0 0 100%;width:100%;order:99;
    display:flex;align-items:center;justify-content:center;gap:8px;
    min-height:46px;margin:12px 0 0;padding:0 10px;
    border:0;border-top:1px solid #ece6d8;background:#fbf7ee;color:#7d6218;
    cursor:pointer;font:800 13px/1.1 inherit;letter-spacing:.02em;
    -webkit-tap-highlight-color:transparent;transition:background .15s ease,color .15s ease;}
  .basket-card .rh-flip:hover{background:#f3ead6;color:#111;}
  .basket-card .rh-flip:active{background:#ecdfc2;}
  .basket-card .rh-flip svg{flex:0 0 auto;}
  @media (max-width:600px){
    .basket-card{flex-wrap:wrap;}
    .basket-card .rh-flip{min-height:44px;font-size:12px;margin-top:10px;}
    .basket-card .rh-flip svg{width:12px;height:12px;}
  }

  /* -- "The big ones" band -- */
  .rh-scale{max-width:1100px;margin:26px auto 0;padding:18px;background:#fffdf7;
    border:1px solid #ece6d8;border-radius:16px;
    display:grid;grid-template-columns:1fr 500px;gap:24px;align-items:center;}
  .rh-scale__label{margin:0 0 4px;font-size:12px;font-weight:800;letter-spacing:.08em;
    text-transform:uppercase;color:#7d6218;}
  .rh-scale__h{margin:0;font-size:19px;font-weight:800;color:#111;letter-spacing:-.01em;}
  .rh-scale__p{margin:8px 0 0;font-size:14px;line-height:1.5;color:#4b5563;}
  .rh-scale__pics{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .rh-scale__pics figure{margin:0;}
  .rh-scale__pics img{width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;
    border-radius:12px;display:block;background:#fff;border:1px solid #f0eade;}
  @media (max-width:860px){
    .rh-scale{grid-template-columns:1fr;gap:14px;margin-top:20px;padding:15px;}
    .rh-scale__h{font-size:17px;}
    .rh-scale__p{font-size:13px;}
  }
</style>
<script>
/* card id -> wrapped photo. These are Mikey's uploads, unedited. */
window.RH_WRAPPED = {
    'size-small':  "{{ 'bbr-small_round_rosh_wrapped.jpg' | asset_url }}",
    'size-medium': "{{ 'bbr-medium_round_rosh_wrapped.jpg' | asset_url }}",
    'size-large':  "{{ 'bbr-large_oval_rosh_wrapped.jpg' | asset_url }}",
    'size-xl':     "{{ 'bbr-extra_large_rosh_wrapped.jpg' | asset_url }}",
    'size-grand':  "{{ 'bbr-grand_oval_rosh_wrapped.jpg' | asset_url }}",
    'size-jumbo':  "{{ 'bbr-jumbo_rosh_wrapped.jpg' | asset_url }}"
};
(function(){
  var ICON='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>';
  function build(){
    var map=window.RH_WRAPPED||{};
    Object.keys(map).forEach(function(id){
      var card=document.getElementById(id); if(!card) return;
      var img=card.querySelector('.basket-image');
      if(!img || card.querySelector('.rh-flip')) return;
      var openSrc=img.getAttribute('src'), wrapSrc=map[id];
      var probe=new Image();
      probe.onload=function(){
        var btn=document.createElement('button');
        btn.type='button'; btn.className='rh-flip'; btn.setAttribute('aria-pressed','false');
        btn.innerHTML=ICON+'<span>See it wrapped</span>';
        btn.addEventListener('click',function(e){
          e.stopPropagation(); e.preventDefault();
          var on=card.classList.toggle('is-wrapped');
          img.setAttribute('src', on?wrapSrc:openSrc);
          btn.setAttribute('aria-pressed', on?'true':'false');
          btn.querySelector('span').textContent = on ? "See what's inside" : 'See it wrapped';
        });
        card.appendChild(btn);
      };
      probe.src=wrapSrc;
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',build); else build();
})();
</script>
