<script>
/* === Basket Builder Mobile Pillbar + Proportional Ladder — 2026-05-09 === */
(function () {
  // Basket diameter in inches — drives proportional icon size in the ladder
  var BASKET_DIAMETER = {
    'size-small': 10,
    'size-medium': 12,
    'size-large': 16,
    'size-xl': 18,
    'size-grand': 20,
    'size-jumbo': 24.5,
    'size-penultimate': 24,
    'size-supreme': 30
  };

  var PILL_LABEL = {
    'size-small': 'Small',
    'size-medium': 'Medium',
    'size-large': 'Large',
    'size-xl': 'XL',
    'size-grand': 'Grand',
    'size-jumbo': 'Jumbo',
    'size-penultimate': 'Penult.',
    'size-supreme': 'Supreme'
  };

  // Inline SVG basket silhouette — cream-gold fill, gold rim/handle
  // Returns SVG string sized to the requested width (height auto-scales).
  function basketSvg(widthPx) {
    var w = Math.round(widthPx);
    var h = Math.round(widthPx * 0.75);
    return '<svg width="' + w + '" height="' + h + '" viewBox="0 0 40 30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
      '<path d="M11 11 Q 11 4, 20 4 Q 29 4, 29 11" fill="none" stroke="#D4AF37" stroke-width="1.6" stroke-linecap="round"/>' +
      '<path d="M4.5 11.5 L35.5 11.5 L32 26 Q 20 28.5, 8 26 Z" fill="#F1E3BF" stroke="#D4AF37" stroke-width="1.2" stroke-linejoin="round"/>' +
      '<path d="M14 13 V 26" stroke="#D4AF37" stroke-width="0.5" opacity="0.5"/>' +
      '<path d="M20 13 V 27" stroke="#D4AF37" stroke-width="0.5" opacity="0.5"/>' +
      '<path d="M26 13 V 26" stroke="#D4AF37" stroke-width="0.5" opacity="0.5"/>' +
      '</svg>';
  }

  function init() {
    var pillbar = document.querySelector('.bb-mobile-pillbar');
    var strip = document.querySelector('.bb-mobile-strip');
    if (!pillbar || !strip) return;
    if (pillbar.dataset.bbBuilt === '1') return;

    var cards = document.querySelectorAll('.basket-grid .basket-card[id^="size-"]');
    if (!cards.length) return;

    // Compute icon size range. Smallest basket = 22px wide, largest = 56px.
    var diameters = Array.prototype.map.call(cards, function (c) {
      return BASKET_DIAMETER[c.id] || 10;
    });
    var minD = Math.min.apply(null, diameters);
    var maxD = Math.max.apply(null, diameters);
    var minPx = 28, maxPx = 66;
    function scale(d) {
      if (maxD === minD) return (minPx + maxPx) / 2;
      return minPx + ((d - minD) / (maxD - minD)) * (maxPx - minPx);
    }

    var pillFrag = document.createDocumentFragment();
    var stripFrag = document.createDocumentFragment();

    cards.forEach(function (card) {
      var id = card.id;
      var label = PILL_LABEL[id] || (card.querySelector('.basket-name') || {}).textContent || id;
      var priceEl = card.querySelector('.basket-price');
      var diameter = BASKET_DIAMETER[id] || 10;

      // Pill (2x4 grid item)
      var pill = document.createElement('a');
      pill.href = '#' + id;
      pill.dataset.target = id;
      pill.textContent = label;
      pillFrag.appendChild(pill);

      // Strip ladder item — proportional SVG basket
      var thumb = document.createElement('a');
      thumb.href = '#' + id;
      thumb.dataset.target = id;
      thumb.setAttribute('aria-label', label);
      thumb.innerHTML = basketSvg(scale(diameter));
      var price = document.createElement('span');
      price.className = 'bb-strip-price';
      price.textContent = priceEl ? priceEl.textContent.trim() : '';
      thumb.appendChild(price);
      stripFrag.appendChild(thumb);
    });

    pillbar.appendChild(pillFrag);
    strip.appendChild(stripFrag);
    pillbar.dataset.bbBuilt = '1';

    function onAnchorClick(e) {
      var a = e.target.closest('a[data-target]');
      if (!a) return;
      var target = document.getElementById(a.dataset.target);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setActive(a.dataset.target);
    }
    pillbar.addEventListener('click', onAnchorClick);
    strip.addEventListener('click', onAnchorClick);

    function setActive(id) {
      pillbar.querySelectorAll('a').forEach(function (a) {
        a.classList.toggle('is-active', a.dataset.target === id);
      });
      strip.querySelectorAll('a').forEach(function (a) {
        a.classList.toggle('is-active', a.dataset.target === id);
      });
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        var best = null;
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          if (!best || en.intersectionRatio > best.intersectionRatio) best = en;
        });
        if (best && best.target.id) setActive(best.target.id);
      }, { rootMargin: '-30% 0px -50% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });
      cards.forEach(function (c) { io.observe(c); });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>





