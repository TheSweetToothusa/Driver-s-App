                    <div class="os-si" id="si-wrap">
                        <button type="button" id="si-toggle" class="os-si-toggle" aria-expanded="false" aria-controls="special-instructions" onclick="toggleSpecialInstructions(this)">
                            <span class="os-si-left"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;color:#6b7280;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Special Instructions</span>
                            <svg class="os-si-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
