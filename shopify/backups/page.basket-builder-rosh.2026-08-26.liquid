    </div>
</div>
<script>
        // State
        let selectedOccasion = 'Rosh Hashanah';  // this page is Rosh Hashanah only — occasion step skipped
        let schoolName = '';
        let basketData = { name: '', capacity: 0, price: 0 };
        let upsellQuantities = {};
        let selectedCookieFlavor = null;
        // Free chocolate plaque by occasion — top-level so both the line item
        // properties and the order-level cart attributes can read it.
        // Add new occasions here as plaque designs become available.
        const freePlaqueByOccasion = {
            'Birthday': 'Happy Birthday',
            'Anniversary': 'Happy Anniversary',
            'Thank You': 'Thank You',
            'Get Well': 'Get Well Soon',
            'Congratulations': 'Congratulations',
            'Housewarming': 'New Home'
        };

        let selectedPlaqueOccasion = null;
        const plaqueOccasions = {
            'happy-birthday':    { name: 'Happy Birthday',       dairy: 48554746544383, vegan: 48554746708223 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/milk-happy-birthday-plaque.jpg?v=1784287112' },
            'happy-anniversary': { name: 'Happy Anniversary',    dairy: 48554746577151, vegan: 48554746740991 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/milk-happy-anniversary-plaque.jpg?v=1784287687' },
            'i-love-you':        { name: 'I Love You',           dairy: 48843042521343, vegan: 48843043143935 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/I_Love_You_Large_Chocolate_Plaque_481edb95-4de5-4dc7-8d2c-7db6d79a7f5f.png?v=1784215894' },
            'thank-you':         { name: 'Thank You',            dairy: 48554746609919, vegan: 48554746773759 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/thank-you-chocolate-plaque-milk.jpg?v=1784301457' },
            'get-well':          { name: 'Get Well Soon',        dairy: 48554746642687, vegan: 48554746806527 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/milk-get-well-soon-plaque.jpg?v=1784288370' },
            'congratulations':   { name: 'Congratulations',      dairy: 48554746675455, vegan: 48554746839295 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/milk-congratulations-plaque.jpg?v=1784287115' },
            'new-home':          { name: 'New Home - Large Key', dairy: 48844027920639, vegan: 48844101189887 , img: 'https://cdn.shopify.com/s/files/1/0559/8498/0141/files/Chocolate_Large_housekey_d59d2d19-6bc2-467b-aaf8-e547f1b22926.png?v=1784227616' }
        };
        let selectedPlaque = false;
        let glutenFreeUpgrade = false;
        

        // Container type and gender
        let containerType = 'basket';
        let babyGender = null;
        
        // Diet selection (Dairy/Vegan)
        let selectedDiet = 'dairy';
        
        function selectDiet(diet) {
            selectedDiet = diet;
            
            // Update pill styles
            document.getElementById('diet-dairy').classList.toggle('selected', diet === 'dairy');
            document.getElementById('diet-vegan').classList.toggle('selected', diet === 'vegan');
            
            // Store selection for checkout
            window.selectedDiet = diet;
            console.log('Diet selected:', diet);
            if (typeof rhRefreshAddons === 'function') rhRefreshAddons();
        }
        
        // Toggle between basket and bassinet
        function toggleContainer(type) {
            containerType = type;
            
            // Update toggle buttons
            document.getElementById('toggle-basket').classList.toggle('active', type === 'basket');
            document.getElementById('toggle-bassinet').classList.toggle('active', type === 'bassinet');
            
            // Show/hide grids
            document.querySelector('.basket-grid').style.display = type === 'basket' ? 'grid' : 'none';
            document.getElementById('bassinet-grid').classList.toggle('visible', type === 'bassinet');
            
            // Show/hide gender selection for BASSINET
            document.getElementById('gender-selection').classList.toggle('visible', type === 'bassinet');
            
            // Show/hide gender selection for TRADITIONAL BASKET (only when Baby occasion)
            const traditionalGenderSection = document.getElementById('baby-gender-traditional');
            if (traditionalGenderSection) {
                traditionalGenderSection.classList.toggle('visible', type === 'basket' && selectedOccasion === 'Baby');
            }
            
            // Reset selection
            document.querySelectorAll('.basket-card').forEach(card => card.classList.remove('selected'));
            
            // For bassinet: Auto-select Medium size so Continue button appears
            if (type === 'bassinet') {
                // Set the default Medium bassinet selection
                document.getElementById('bassinet-serving').textContent = 'Serves 12-18 people';
                basketData = {
                    name: 'Medium Bassinet',
                    capacity: 55,
                    price: 149
                };
                // Show the continue button and update display
                document.getElementById('selected-basket-display').textContent = 'Medium Bassinet - $149';
                trackerLockSync();
                document.getElementById('basket-continue').style.display = 'block';
                var bh = document.getElementById('basket-hint'); if (bh) bh.style.display = 'none';
                // Update total price display
                updateTotalPrice();
            } else {
                document.getElementById('basket-continue').style.display = 'none';
                var bh2 = document.getElementById('basket-hint'); if (bh2) bh2.style.display = 'block';
            }
            
            // Reset gender selection when switching container types
            babyGender = null;
            document.querySelectorAll('.gender-btn').forEach(btn => btn.classList.remove('selected', 'selected-girl', 'selected-boy'));
            // Reset gender confirmations and container colors
            document.querySelectorAll('.gender-confirmation').forEach(el => { el.className = 'gender-confirmation'; el.innerHTML = ''; });
            const tradContainer = document.getElementById('baby-gender-traditional');
            if (tradContainer) tradContainer.classList.remove('gender-girl', 'gender-boy');
        }
        
        // Select baby gender (for bassinet)
        function selectGender(gender) {
            babyGender = gender;
            var ge = document.getElementById('baby-gender-error'); if (ge) ge.style.display = 'none';

            // Update button states
            document.querySelectorAll('#gender-selection .gender-btn').forEach(btn => {
                btn.classList.remove('selected', 'selected-girl', 'selected-boy');
            });
            const clickedBtn = event.target.closest('.gender-btn');
            clickedBtn.classList.add('selected');
            clickedBtn.classList.add(gender === 'girl' ? 'selected-girl' : 'selected-boy');
            
            // Show confirmation message
            const confirm = document.getElementById('bassinet-gender-confirm');
            confirm.className = 'gender-confirmation visible ' + (gender === 'girl' ? 'girl' : 'boy');
            confirm.innerHTML = gender === 'girl' 
                ? '🎀 Baby Girl bassinet selected — pink ribbons & girl-themed chocolates!'
                : '💙 Baby Boy bassinet selected — blue ribbons & boy-themed chocolates!';
            
            // Update bassinet images
            const girlImg = '{{ "bb-baby-girl-bassinet.jpg" | asset_url }}';
            const boyImg = '{{ "bb-baby-boy-bassinet.jpg" | asset_url }}';
            
            const imgSrc = gender === 'girl' ? girlImg : boyImg;
            document.getElementById('bassinet-small-img').src = imgSrc;
            document.getElementById('bassinet-medium-img').src = imgSrc;
            document.getElementById('bassinet-large-img').src = imgSrc;
        }
        
        // Select baby gender for TRADITIONAL baskets (not bassinets)
        function selectTraditionalBabyGender(gender) {
            babyGender = gender;
            var ge = document.getElementById('baby-gender-error'); if (ge) ge.style.display = 'none';

            // Update button states in the traditional gender section
            const container = document.getElementById('baby-gender-traditional');
            container.querySelectorAll('.gender-btn').forEach(btn => {
                btn.classList.remove('selected', 'selected-girl', 'selected-boy');
            });
            const clickedBtn = event.target.closest('.gender-btn');
            clickedBtn.classList.add('selected');
            clickedBtn.classList.add(gender === 'Girl' ? 'selected-girl' : 'selected-boy');
            
            // Change container background color
            container.classList.remove('gender-girl', 'gender-boy');
            container.classList.add(gender === 'Girl' ? 'gender-girl' : 'gender-boy');
            
            // Show confirmation message
            const confirm = document.getElementById('traditional-gender-confirm');
            confirm.className = 'gender-confirmation visible ' + (gender === 'Girl' ? 'girl' : 'boy');
            confirm.innerHTML = gender === 'Girl' 
                ? '🎀 Baby Girl basket selected — we\'ll add pink ribbons & girl-themed chocolates!'
                : '💙 Baby Boy basket selected — we\'ll add blue ribbons & boy-themed chocolates!';
            
            console.log('Baby gender selected for traditional basket:', gender);
        }
        
        // Show/hide sections
        function validateAndContinue() {
            // If College Acceptance, require school name
            if (selectedOccasion === 'College Acceptance') {
                const schoolInput = document.getElementById('school-name-input');
                const schoolError = document.getElementById('school-name-error');
                const val = schoolInput?.value?.trim() || '';
                if (!val) {
                    schoolError.style.display = 'block';
                    schoolInput.style.border = '2px solid #dc2626';
                    schoolInput.focus();
                    schoolInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                } else {
                    schoolError.style.display = 'none';
                    schoolInput.style.border = '';
                }
            }
            goToStep('step-size');
        }
        
        function trackerMark(step) {
            document.querySelectorAll('.bb-tstep').forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-step') === step); });
            trackerLockSync();
        }

        // Step 2 stays locked until a basket size is chosen.
        function bbStepUnlocked(step) {
            if (step === 'step-size') return true;
            return !!(basketData && basketData.name);
        }

        function trackerLockSync() {
            document.querySelectorAll('.bb-tstep').forEach(function(b){
                var locked = !bbStepUnlocked(b.getAttribute('data-step'));
                b.classList.toggle('locked', locked);
                b.setAttribute('aria-disabled', locked ? 'true' : 'false');
            });
        }

        function trackerGo(step) {
            if (!bbStepUnlocked(step)) {
                var nudge = document.getElementById('bb-step-nudge');
                if (nudge) {
                    nudge.style.display = 'block';
                    clearTimeout(window.__bbNudgeTimer);
                    window.__bbNudgeTimer = setTimeout(function(){ nudge.style.display = 'none'; }, 4000);
                }
                var grid = document.querySelector('#step-size .basket-grid');
                if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }
            goToStep(step);
        }

        function goToStep(stepId) {
            if (stepId === 'step-upsells' && typeof rhRefreshAddons === 'function') setTimeout(rhRefreshAddons, 0);
            // Require Baby Boy / Baby Girl choice before leaving the size step.
            // Show an inline nudge (not a pop-up) and guide them to the choice.
            if (stepId === 'step-upsells' && selectedOccasion === 'Baby' && !babyGender) {
                var bassSel = document.getElementById('gender-selection');
                var target = (bassSel && bassSel.classList.contains('visible'))
                    ? bassSel
                    : document.getElementById('baby-gender-traditional');
                var err = document.getElementById('baby-gender-error');
                if (err) err.style.display = 'block';
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
            document.querySelectorAll('.section').forEach(section => {
                section.classList.remove('active');
            });
            document.getElementById(stepId).classList.add('active');
            trackerMark(stepId);
            window.scrollTo(0, 0);
            
            // Show container toggle if Baby occasion and going to size step
            if (stepId === 'step-size' && selectedOccasion === 'Baby') {
                document.getElementById('container-toggle').classList.add('visible');
                // Also show traditional baby gender selection by default (basket is default)
                document.getElementById('baby-gender-traditional').classList.add('visible');
            } else {
                document.getElementById('container-toggle').classList.remove('visible');
                document.getElementById('gender-selection').classList.remove('visible');
                document.getElementById('baby-gender-traditional').classList.remove('visible');
                document.getElementById('bassinet-grid').classList.remove('visible');
                document.querySelector('.basket-grid').style.display = 'grid';
            }
        }
        
        // Step 1: Select Occasion
        function selectOccasion(element, occasion) {
            // Remove previous selection
            document.querySelectorAll('.occasion-card').forEach(card => {
                card.classList.remove('selected');
            });
            
            // Highlight selected
            element.classList.add('selected');
            selectedOccasion = occasion;
            
            // Hide all info banners first
            document.querySelectorAll('.occasion-info-banner').forEach(banner => {
                banner.classList.remove('visible');
            });
            
            // Show relevant info banner (College Acceptance, Rosh Hashanah)
            if (occasion === 'College Acceptance') {
                document.getElementById('college-info').classList.add('visible');
            }
            if (occasion === 'Rosh Hashanah') {
                document.getElementById('rosh-info').classList.add('visible');
            }
            
            // Show continue button
            document.getElementById('occasion-continue').style.display = 'block';
            var oh = document.getElementById('occasion-hint'); if (oh) oh.style.display = 'none';
            document.getElementById('selected-occasion-display').textContent = occasion;
            
            // Scroll to continue button (or info banner if visible)
            const visibleBanner = document.querySelector('.occasion-info-banner.visible');
            if (visibleBanner) {
                visibleBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                document.getElementById('occasion-continue').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
        
        // Step 2: Select Basket
        function selectBasket(element, name, capacity, price) {
            // Remove previous selection
            document.querySelectorAll('.basket-card').forEach(card => {
                card.classList.remove('selected');
            });
            
            // Highlight selected
            element.classList.add('selected');
            basketData = { name, capacity, price };
            trackerLockSync();

            // Show continue button
            document.getElementById('basket-continue').style.display = 'block';
            var bh = document.getElementById('basket-hint'); if (bh) bh.style.display = 'none';
            document.getElementById('selected-basket-display').textContent = name + ' - $' + price;
            
            // Update total
            updateTotalPrice();
            
            // Scroll to continue button
            document.getElementById('basket-continue').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        
        // Cookie flavor selection
        function selectCookieFlavor(flavor) {
            // Remove previous selection
            document.querySelectorAll('.flavor-pill').forEach(btn => {
                btn.style.background = 'white';
                btn.style.borderColor = '#e5e7eb';
                btn.style.color = '#111111';
                btn.style.fontWeight = 'normal';
            });
            
            // Highlight selected
            event.target.style.background = '#111111';
            event.target.style.borderColor = '#111111';
            event.target.style.color = 'white';
            event.target.style.fontWeight = '600';
            
            // Show selection message
            const flavorNames = {
                'choc-chip': 'Chocolate Chip',
                'white-choc': 'White Chocolate Macadamia',
                'oatmeal': 'Oatmeal Raisin',
                'mixed': 'Mixed'
            };
            const msgEl = document.getElementById('cookie-selection-msg');
            if (msgEl) {
                msgEl.textContent = '✓ ' + flavorNames[flavor] + ' selected';
            }
            
            selectedCookieFlavor = flavor;
        }

        function selectPlaqueOccasion(occ, btnEl) {
            document.querySelectorAll('.plaque-pill').forEach(btn => {
                btn.style.background = 'white';
                btn.style.borderColor = '#e5e7eb';
                btn.style.color = '#111111';
                btn.style.fontWeight = 'normal';
            });
            const target = btnEl || (window.event && window.event.target);
            if (target) {
                target.style.background = '#111111';
                target.style.borderColor = '#111111';
                target.style.color = 'white';
                target.style.fontWeight = '600';
            }

            const data = plaqueOccasions[occ];
            const imgEl = document.getElementById('plaque-addon-img');
            if (imgEl && data.img) {
                imgEl.src = data.img;
                imgEl.alt = data.name + ' large chocolate plaque';
            }
            const msgEl = document.getElementById('plaque-selection-msg');
            if (msgEl) {
                msgEl.textContent = '✓ ' + data.name + ' selected';
            }

            selectedPlaqueOccasion = occ;
        }

        // Pre-select the Congratulations pill (matches the default hero image) so the
        // + button works immediately. Nothing is added to the cart until + is tapped.
        document.addEventListener('DOMContentLoaded', function() {
            var defaultPill = document.querySelector('.plaque-pill[onclick*="congratulations"]');
            if (defaultPill) selectPlaqueOccasion('congratulations', defaultPill);
            trackerLockSync();
        });

        function toggleSpecialInstructions(btn) {
            var wrap = document.getElementById('si-wrap');
            var open = wrap.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) { document.getElementById('special-instructions').focus(); }
        }

        function adjustPlaqueQty(change) {
            if (!selectedPlaqueOccasion) {
                const msgEl = document.getElementById('plaque-selection-msg');
                if (msgEl) {
                    msgEl.textContent = 'Please choose an occasion first';
                }
                return;
            }
            // each occasion is its own line item, so you can add e.g. a Birthday AND a Congratulations plaque
            adjustQty('plaque-' + selectedPlaqueOccasion, change, 20);
            let total = 0;
            for (const [id, data] of Object.entries(upsellQuantities)) {
                if (id.startsWith('plaque-')) total += (data.qty || 0);
            }
            const disp = document.getElementById('qty-plaque');
            if (disp) disp.textContent = total;
            const msgEl = document.getElementById('plaque-selection-msg');
            if (msgEl) {
                const parts = [];
                for (const [id, data] of Object.entries(upsellQuantities)) {
                    if (id.startsWith('plaque-') && data.qty > 0) {
                        parts.push(plaqueOccasions[id.slice(7)].name + ' x' + data.qty);
                    }
                }
                msgEl.textContent = parts.length ? '✓ ' + parts.join(' · ') : '✓ ' + plaqueOccasions[selectedPlaqueOccasion].name + ' selected';
            }
        }

        // Plaque selection
        // Gluten-Free Upgrade — set explicit state (used by +/− buttons in add-ons list, ?gf=1 URL param, and "Remove" link in banner)
        function setGlutenFree(state) {
            if (glutenFreeUpgrade === state) return;
            glutenFreeUpgrade = state;

            // Update qty display on the GF row itself
            const qtyDisplay = document.getElementById('qty-gf-upgrade');
            if (qtyDisplay) qtyDisplay.textContent = state ? '1' : '0';

            // Show/hide the sticky banner
            const banner = document.getElementById('gf-mode-banner');
            if (banner) banner.style.display = state ? 'block' : 'none';

            // Hide the GF row at the bottom of the add-ons when banner is on (avoid redundant "selected" UI)
            const gfRow = document.getElementById('gf-row');
            if (gfRow) gfRow.style.display = state ? 'none' : '';

            // Hide non-GF add-on rows when GF is on; reset their quantities to 0
            document.querySelectorAll('[data-non-gf="true"]').forEach(function(row) {
                row.style.display = state ? 'none' : '';
            });
            if (state) {
