        .info-icon:hover {
            background: #111111;
            transform: scale(1.1);
        }
        
        .basket-card.selected .info-icon {
            right: 55px;
        }
        
        /* Tooltip */
        .tooltip {
            position: absolute;
            top: 50px;
            right: 10px;
            width: 280px;
            background: #111111;
            color: white;
            padding: 16px;
            border-radius: 12px;
            font-size: 0.85rem;
            line-height: 1.5;
            z-index: 100;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.2s;
            pointer-events: none;
        }
        
        .info-icon:hover + .tooltip,
        .tooltip:hover {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            pointer-events: auto;
        }
        
        .tooltip h5 {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: #f1a4ba;
        }
        
        .tooltip ul {
            list-style: none;
            padding: 0;
            margin: 0 0 10px 0;
        }
        
        .tooltip ul li {
            padding: 3px 0;
            padding-left: 16px;
            position: relative;
        }
        
        .tooltip ul li::before {
            content: '•';
            position: absolute;
            left: 0;
            color: #f1a4ba;
        }
        
        .tooltip .tooltip-note {
            font-size: 0.8rem;
            color: #9ca3af;
            font-style: italic;
            border-top: 1px solid #333;
            padding-top: 10px;
            margin-top: 10px;
