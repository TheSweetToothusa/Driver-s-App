            // Add gluten-free upgrade if selected
            if (glutenFreeUpgrade) {
                total += 20;
            }
            
            const totalEl = document.getElementById('totalPrice');
            if (totalEl) {
                totalEl.textContent = '$' + total;
            }
            updateSummary();
        }
        
