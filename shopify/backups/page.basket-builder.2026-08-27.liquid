        function updateTotalPrice() {
            let total = basketData.price;
            
            // Add all upsells
            for (let itemId in upsellQuantities) {
                total += upsellQuantities[itemId].qty * upsellQuantities[itemId].price;
            }
            
            // Add plaque if selected
            if (selectedPlaque) {
                total += 8;
            }
            
            // Add gluten-free upgrade if selected
            if (glutenFreeUpgrade) {
                total += gfTier().price;
            }
            
            const totalEl = document.getElementById('totalPrice');
            if (totalEl) {
                totalEl.textContent = '$' + total;
            }
            updateSummary();
        }
        
