        // Quantity controls
        function adjustQty(itemId, change, price) {
            if (!upsellQuantities[itemId]) {
                upsellQuantities[itemId] = { qty: 0, price: price };
            }
            
            upsellQuantities[itemId].qty = Math.max(0, upsellQuantities[itemId].qty + change);
            
            const displayEl = document.getElementById('qty-' + itemId);
            if (displayEl) {
                displayEl.textContent = upsellQuantities[itemId].qty;
            }
            
            updateTotalPrice();
        }
        
