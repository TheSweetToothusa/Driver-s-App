<style>
  /* -- "See it wrapped" toggle. Same bar as the Rosh Hashanah builder:
        full-width across the bottom of the card, in normal flow, 46px tall
        so it is easy to hit. Square corners so it is never confused with
        the "Serves X people" pill. -- */
  .basket-card{position:relative;}
  .basket-card .rh-flip{position:static;flex:0 0 100%;width:100%;order:99;
    display:flex;align-items:center;justify-content:center;gap:8px;
    min-height:46px;margin:12px 0 0;padding:0 10px;
    border:0;border-top:1px solid #ece6d8;background:#fbf7ee;color:#7d6218;
    cursor:pointer;font:800 13px/1.1 inherit;letter-spacing:.02em;
    -webkit-tap-highlight-color:transparent;transition:background .15s ease,color .15s ease;}
  .basket-card .rh-flip:hover{background:#f3ead6;color:#111;}
  .basket-card .rh-flip:active{background:#ecdfc2;}
  .basket-card .rh-flip svg{flex:0 0 auto;}
  .basket-card.is-wrapped .basket-image{padding:0 !important;}
  /* Mobile cards here are a row (image left / text right), so let the bar
     wrap onto its own full-width line underneath both columns. */
  @media (max-width:749px){
    .basket-card{flex-wrap:wrap !important;}
    .basket-card .rh-flip{flex:0 0 100% !important;width:100% !important;order:99 !important;
      min-height:44px !important;font-size:12px !important;margin-top:10px !important;}
    .basket-card .rh-flip svg{width:12px !important;height:12px !important;}
  }

  /* -- Card bottom alignment.
        The flip bar used to sit wherever the text ended, so Jumbo's two-line
        detail line ("24.5" x 17" Rectangle") pushed its bar ~30px below the
        bars on the cards either side of it. Cards are already equal height,
        so pin the bar to the bottom and every card lines up regardless of how
        the copy wraps. Also tightens the detail tracking from +0.03em, which
        is what forced Jumbo onto a second line in the first place (330px of
        text in a 309px column). No copy changes, no dimensions dropped. -- */
  @media (min-width:750px){
    .basket-card{display:flex;flex-direction:column;}
    .basket-card .basket-image,
    .basket-card .basket-content{flex:0 0 auto;}
    .basket-card .rh-flip{flex:0 0 auto;width:100%;margin-top:auto;}
    .basket-card .basket-details{letter-spacing:-0.01em;}
  }
</style>
<script>
/* card id -> wrapped photo. These are Mikey's uploads, unedited. */
window.BB_WRAPPED = {
    'size-small':       "{{ 'bb-small_round_wrapped.jpg' | asset_url }}",
    'size-medium':      "{{ 'bb-medium_round_wrapped.jpg' | asset_url }}",
    'size-large':       "{{ 'bb-large_oval_wrapped.jpg' | asset_url }}",
    'size-xl':          "{{ 'bb-extra_large_wrapped.jpg' | asset_url }}",
    'size-grand':       "{{ 'bb-grand_oval_wrapped.png' | asset_url }}",
    'size-jumbo':       "{{ 'bb-jumbo_wrapped.png' | asset_url }}",
    'size-penultimate': "{{ 'bb-penultimate_wrapped.jpg' | asset_url }}",
    'size-supreme':     "{{ 'bb-supreme_wrapped.png' | asset_url }}"
};
(function(){
  var ICON='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>';
  function build(){
    var map=window.BB_WRAPPED||{};
    Object.keys(map).forEach(function(id){
      var card=document.getElementById(id); if(!card) return;
      var img=card.querySelector('.basket-image');
      if(!img || card.querySelector('.rh-flip')) return;
      var openSrc=img.getAttribute('src'), wrapSrc=map[id];
      var probe=new Image();
      probe.onload=function(){
        var btn=document.createElement('button');
        btn.type='button'; btn.className='rh-flip'; btn.setAttribute('aria-pressed','false');
        btn.innerHTML=ICON+'<span>See it wrapped</span>';
        btn.addEventListener('click',function(e){
          e.stopPropagation(); e.preventDefault();
          var on=card.classList.toggle('is-wrapped');
          img.setAttribute('src', on?wrapSrc:openSrc);
          btn.setAttribute('aria-pressed', on?'true':'false');
          btn.querySelector('span').textContent = on ? "See what's inside" : 'See it wrapped';
        });
        card.appendChild(btn);
      };
      probe.src=wrapSrc;
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',build); else build();
})();
</script>
